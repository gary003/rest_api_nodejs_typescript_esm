{
  "author": "Gary Johnson",
  "description": "This is a portfolio project use to demonstrate skills",
  "name": "rest_api_nodejs_typescript_esm",
  "version": "1",
  "main": "./src/bin/server.ts",
  "type": "module",
  "scripts": {
    "start": "npm run clean && docker compose up --build -d",
    "stop": "docker compose down --remove-orphans",
    "build:app": "npx tsc -p .",
    "rebuild": "docker compose build --no-cache",
    "dev:start": "npm run dev:seed:db && NODE_ENV=development DB_DRIVER=sqlite DB_DATABASE_NAME=src/v1/infrastructure/persistence/database/db_test_development/db_file_volume/sqlite.db dotenv -e .env.dev npx tsx watch src/bin/server.ts",
    "dev:seed:db": "npx tsx src/v1/infrastructure/persistence/database/db_test_development/db_file_scripts/seed_local_db.ts",
    "minify": "bash ./scripts/minify_p.sh",
    "pm2:clean": " npx pm2 kill",
    "clean": "npm run stop && npm run pm2:clean && npm run docker:clean:volumes",
    "docker:logs:app": "docker compose logs app",
    "docker:logs:db": "docker compose logs db",
    "docker:build:image": "docker build -t gary003/rest_api_nodejs_typescript_esm .",
    "docker:launch:app": "npx pm2-docker start ecosystem.config.js --only server",
    "docker:clean": "docker system prune -af --volumes || true",
    "docker:clean:volumes": "docker volume prune -f || true",
    "docker:clean:volumes:hard": "rm -rf src/v1/infrastructure/persistence/database/db_volume/* && docker volume prune -f || true",
    "docker:clean:images": "docker image prune -af || true",
    "lint": "npx eslint .",
    "test": "bash ./scripts/test_all.sh",
    "test:ci": "bash ./scripts/test_all_ci.sh",
    "test:integration": "bash ./scripts/test_integration.sh",
    "test:load": "npm run clean && npx vitest run './tests/load'",
    "test:unit:v1": "npm run clean && npx vitest run --coverage './tests/unit/v1'"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.62.0",
    "@opentelemetry/sdk-node": "^0.203.0",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "@opentelemetry/winston-transport": "^0.14.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.1.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "latest",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "pm2": "^6.0.14",
    "redis": "^4.7.1",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0",
    "winston": "^3.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.12",
    "@types/crypto-js": "^4.1.1",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.1",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitest/coverage-v8": "^4.0.16",
    "c8": "^10.1.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.1.8",
    "openapi3-ts": "^4.4.0",
    "prettier": "^3.7.4",
    "swagger-ui-express": "^5.0.1",
    "testcontainers": "^10.16.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^4.0.16"
  },
  "license": "MIT"
}
